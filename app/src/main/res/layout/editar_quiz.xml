<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#1A2130">

    <TextView
        android:id="@+id/tv_titulo_alterar_quiz"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Alterar Dados do Quiz"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#E0E0E0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/label_titulo_alterar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Título do Quiz"
        android:textSize="16sp"
        android:textColor="#E0E0E0"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo_alterar_quiz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_titulo_antigo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Título Antigo:"
        android:textSize="16sp"
        android:textColor="#FF8C00"
        android:background="#303030"
        android:padding="10dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/label_titulo_alterar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/et_titulo_quiz"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:inputType="textCapSentences"
        android:textColor="#E0E0E0"
        android:textColorHint="#A0A0A0"
        android:hint="Novo Título"
        android:backgroundTint="#A0A0A0"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/tv_titulo_antigo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/label_descricao_alterar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Descrição do Quiz"
        android:textSize="16sp"
        android:textColor="#E0E0E0"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/et_titulo_quiz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_descricao_antiga"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Descrição Antiga:"
        android:textSize="16sp"
        android:textColor="#FF8C00"
        android:background="#303030"
        android:padding="10dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/label_descricao_alterar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/et_descricao_quiz"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:backgroundTint="#A0A0A0"
        android:gravity="top|start"
        android:hint="Nova Descrição"
        android:inputType="textMultiLine"
        android:minHeight="48dp"
        android:textColor="#E0E0E0"
        android:textColorHint="#A0A0A0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_descricao_antiga" />

    <TextView
        android:id="@+id/label_tempo_alterar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tempo Máximo"
        android:textSize="16sp"
        android:textColor="#E0E0E0"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/et_descricao_quiz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_tempo_antigo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Valor Antigo: 60"
        android:textSize="16sp"
        android:textColor="#FF8C00"
        android:background="#303030"
        android:padding="10dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/label_tempo_alterar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/et_tempo_quiz"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:hint="Novo Tempo"
        android:inputType="number"
        android:minHeight="48dp"
        android:textColor="#E0E0E0"
        android:textColorHint="#A0A0A0"
        android:backgroundTint="#A0A0A0"
        app:layout_constraintTop_toBottomOf="@id/tv_tempo_antigo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_alterar_quiz"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:backgroundTint="#FF8C00"
        android:paddingVertical="14dp"
        android:text="Guardar"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/btn_cancelar_alteracoes"
        app:layout_constraintTop_toBottomOf="@id/et_tempo_quiz"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_cancelar_alteracoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="12dp"
        android:backgroundTint="@android:color/transparent"
        android:paddingVertical="14dp"
        android:text="CANCELAR"
        android:textColor="#A0A0A0"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_alterar_quiz"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_tempo_quiz"
        app:layout_constraintVertical_bias="0.0"
        />

</androidx.constraintlayout.widget.ConstraintLayout>