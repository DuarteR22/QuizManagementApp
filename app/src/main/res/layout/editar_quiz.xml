<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#1A2130">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_titulo_alterar_quiz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Alterar Dados do Quiz"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#E0E0E0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/label_titulo_alterar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Título atual:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#A0A0A0"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/tv_titulo_alterar_quiz"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_titulo_antigo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#212121"
            android:padding="8dp"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/label_titulo_alterar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Título do Quiz Antigo" />

        <TextView
            android:id="@+id/label_novo_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Novo Título (opcional):"
            android:textStyle="bold"
            android:textColor="#E0E0E0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_titulo_antigo" />

        <EditText
            android:id="@+id/et_titulo_quiz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Introduza o novo título"
            android:inputType="textCapSentences"
            android:textColor="#E0E0E0"
            android:textColorHint="#A0A0A0"
            android:backgroundTint="#FF8C00"
            android:minHeight="48dp"
            app:layout_constraintTop_toBottomOf="@id/label_novo_titulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/label_descricao_alterar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Descrição atual:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#A0A0A0"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/et_titulo_quiz"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_descricao_antiga"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#212121"
            android:padding="8dp"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/label_descricao_alterar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Descrição antiga do quiz." />

        <TextView
            android:id="@+id/label_nova_descricao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nova Descrição (opcional):"
            android:textStyle="bold"
            android:textColor="#E0E0E0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_descricao_antiga" />

        <EditText
            android:id="@+id/et_descricao_quiz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FF8C00"
            android:gravity="top|start"
            android:hint="Introduza a nova descrição"
            android:inputType="textMultiLine"
            android:minHeight="48dp"
            android:textColor="#E0E0E0"
            android:textColorHint="#A0A0A0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/label_nova_descricao" />

        <TextView
            android:id="@+id/label_tempo_alterar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tempo atual:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#A0A0A0"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/et_descricao_quiz"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_tempo_antigo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#212121"
            android:padding="8dp"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/label_tempo_alterar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="60 segundos" />

        <TextView
            android:id="@+id/label_novo_tempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Novo Tempo (opcional):"
            android:textStyle="bold"
            android:textColor="#E0E0E0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_tempo_antigo" />

        <EditText
            android:id="@+id/et_tempo_quiz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Ex: 120"
            android:inputType="number"
            android:minHeight="48dp"
            android:textColor="#E0E0E0"
            android:textColorHint="#A0A0A0"
            android:backgroundTint="#FF8C00"
            app:layout_constraintTop_toBottomOf="@id/label_novo_tempo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_alterar_quiz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:backgroundTint="#FF8C00"
            android:paddingVertical="14dp"
            android:text="GUARDAR"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/btn_cancelar_alteracoes"
            app:layout_constraintTop_toBottomOf="@id/et_tempo_quiz" />

        <Button
            android:id="@+id/btn_cancelar_alteracoes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="@android:color/transparent"
            android:paddingVertical="14dp"
            android:text="CANCELAR"
            android:textColor="#A0A0A0"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_alterar_quiz"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_tempo_quiz"
            app:layout_constraintVertical_bias="0.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>