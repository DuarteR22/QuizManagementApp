<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_questao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/questao_layout_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#303030">

            <ImageView
                android:id="@+id/iv_imagem_questao"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_resposta"
                android:scaleType="centerCrop"
                android:background="#212121"
                android:contentDescription="Imagem da Pergunta"
                app:tint="#FF8C00"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <ImageButton
                android:id="@+id/btn_apagar_questao"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                android:contentDescription="Remover Questão"
                app:tint="@android:color/holo_red_dark"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <ImageButton
                android:id="@+id/btn_alterar_questao"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/editar_quiz"
                android:contentDescription="Editar Questão"
                app:tint="#FF8C00"
                app:layout_constraintEnd_toStartOf="@id/btn_apagar_questao"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tv_pergunta_questao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E0E0E0"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="1. Pergunta"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_imagem_questao"
                app:layout_constraintEnd_toStartOf="@id/btn_alterar_questao"/>

            <TextView
                android:id="@+id/tv_num_respostas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textSize="14sp"
                android:textColor="#A0A0A0"
                tools:text="5 Resp."
                app:layout_constraintTop_toBottomOf="@id/tv_pergunta_questao"
                app:layout_constraintStart_toEndOf="@id/iv_imagem_questao"
                app:layout_constraintEnd_toStartOf="@id/btn_alterar_questao" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>