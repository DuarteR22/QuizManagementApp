<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A2130"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/textView_lista_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Questões do Quiz"
        android:textSize="24sp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="start"
        android:textStyle="bold"
        android:textColor="#E0E0E0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_adicionar_questao"/>
    <ImageButton
    android:id="@+id/btn_adicionar_questao"
    android:layout_width="wrap_content"
    android:layout_height="0dp"
    android:layout_marginEnd="16dp"
    android:src="@drawable/ic_add"
    android:background="@android:color/transparent"
    android:contentDescription="Adicionar Nova Questão"
    app:tint="#FF8C00"
    app:layout_constraintTop_toTopOf="@id/textView_lista_titulo"
    app:layout_constraintBottom_toBottomOf="@id/textView_lista_titulo"
    app:layout_constraintEnd_toEndOf="parent"
    android:padding="16dp" />
    <View
    android:id="@+id/divider_lista"
    android:layout_width="0dp"
    android:layout_height="1dp"
    android:background="#A0A0A0"
    app:layout_constraintTop_toBottomOf="@id/textView_lista_titulo"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_questoes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/divider_lista"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/card_questao" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_resolver_quiz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_seta_resolver" app:tint="#FFFFFF"
        app:backgroundTint="#FF8C00"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:contentDescription="Resolver Quiz" />

</androidx.constraintlayout.widget.ConstraintLayout>