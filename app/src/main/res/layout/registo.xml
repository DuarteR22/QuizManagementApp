<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#1A2130">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp">

        <TextView
            android:id="@+id/tv_registo_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="Criar Conta"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#E0E0E0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_registo_subtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Junte-se ao QuizGame e crie os seus quizzes"
            android:textColor="#A0A0A0"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_registo_titulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/label_registo_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Escolha um nome de utilizador:"
            android:textStyle="bold"
            android:textColor="#E0E0E0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_registo_subtitulo" />

        <EditText
            android:id="@+id/et_registo_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Username desejado"
            android:inputType="text"
            android:textColor="#E0E0E0"
            android:textColorHint="#A0A0A0"
            android:backgroundTint="#FF8C00"
            android:minHeight="48dp"
            app:layout_constraintTop_toBottomOf="@id/label_registo_username"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/label_registo_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Palavra-passe:"
            android:textStyle="bold"
            android:textColor="#E0E0E0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_registo_username" />

        <EditText
            android:id="@+id/et_registo_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Mínimo 6 caracteres"
            android:inputType="textPassword"
            android:textColor="#E0E0E0"
            android:textColorHint="#A0A0A0"
            android:backgroundTint="#FF8C00"
            android:minHeight="48dp"
            app:layout_constraintTop_toBottomOf="@id/label_registo_password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/label_confirm_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Confirmar Palavra-passe:"
            android:textStyle="bold"
            android:textColor="#E0E0E0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/et_registo_password" />

        <EditText
            android:id="@+id/et_confirmar_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Repita a sua password"
            android:inputType="textPassword"
            android:textColor="#E0E0E0"
            android:textColorHint="#A0A0A0"
            android:backgroundTint="#FF8C00"
            android:minHeight="48dp"
            app:layout_constraintTop_toBottomOf="@id/label_confirm_password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_registar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:backgroundTint="#FF8C00"
            android:paddingVertical="14dp"
            android:text="REGISTAR AGORA"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/et_confirmar_password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_regressar_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Já tem conta? Inicie sessão"
            android:textColor="#FF8C00"
            android:textStyle="bold"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/btn_registar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>